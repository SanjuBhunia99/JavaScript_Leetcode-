var maxProduct = function(n) {
    n = Math.abs(n); 

    let max1 = 0;
    let max2 = 0;

    while (n > 0) {
        let d = n % 10;

        if (d >= max1) {
            max2 = max1;
            max1 = d;
        } else if (d > max2) {
            max2 = d;
        }

        n = Math.floor(n / 10);
    }

    return max1 * max2;
};
