var getResults = function(queries) {
    const N = 5 * 10001;
    const bit = new Int32Array(N + 2);
    const bitUpdate = (i, val) => {
        for (; i <= N; i += i & -i)
            bit[i] = Math.max(bit[i], val);
    };
    const bitQuery = (i) => {
        let res = 0;
        for (; i > 0; i -= i & -i)
            res = Math.max(res, bit[i]);
        return res;
    };
    const lowerBound = (arr, val) => {
        let lo = 0, hi = arr.length;
        while (lo < hi) {
            const mid = (lo + hi) >> 1;
            if (arr[mid] < val) lo = mid + 1;
            else hi = mid;
        }
        return lo;
    };
    const obs = new Set([0, N]);
    for (const q of queries)
        if (q[0] === 1) obs.add(q[1]);

    const sorted = [...obs].sort((a, b) => a - b);
    for (let i = 1; i < sorted.length; i++) {
        const gap = sorted[i] - sorted[i - 1];
        bitUpdate(sorted[i], gap);   
    }
    const rawAns = [];
    for (let i = queries.length - 1; i >= 0; i--) {
        const q = queries[i];
        if (q[0] === 2) {
            const [, x, sz] = q;
            const idx = lowerBound(sorted, x + 1) - 1;
            const prev = sorted[idx];     
            const fits = bitQuery(prev) >= sz || (x - prev) >= sz;
            rawAns.push(fits);
        } else {
            const x = q[1];
            const idx = lowerBound(sorted, x);
            const prev = sorted[idx - 1];
            const next = sorted[idx + 1];
            bitUpdate(next, next - prev);
            sorted.splice(idx, 1);
        }
    }

    return rawAns.reverse();
};
