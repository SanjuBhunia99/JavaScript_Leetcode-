var countCompleteComponents = function(n, edges) {
    const adj = Array.from({length: n}, () => []);
    for (const [a, b] of edges) {
        adj[a].push(b);
        adj[b].push(a);
    }

    const visited = new Array(n).fill(false);
    let V = 0, E = 0;

    const dfs = (x) => {
        V++;
        E += adj[x].length;
        visited[x] = true;
        for (const next of adj[x]) {
            if (!visited[next]) dfs(next);
        }
    };

    let res = 0;
    for (let i = 0; i < n; i++) {
        if (!visited[i]) {
            V = 0; E = 0;
            dfs(i);
            if (E === V * (V - 1)) res++;
        }
    }

    return res;
};
