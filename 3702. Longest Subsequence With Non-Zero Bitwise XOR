var longestSubsequence = function(nums) {
    let xor = 0;
    let NonZero = false;

    for (const num of nums) {
        xor ^= num;

        if (num !== 0) {
            NonZero = true;
        }
    }

    if (xor !== 0) {
        return nums.length;
    }
    if (!NonZero) {
        return 0;
    }
    return nums.length - 1;
};
