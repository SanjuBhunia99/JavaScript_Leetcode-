var sumAndMultiply = function (s, queries) {
    const MOD = 1000000007n;
    const n = s.length;

    const prefixSum = new Array(n + 1).fill(0);
    const prefixCnt = new Array(n + 1).fill(0);
    const prefixNum = new Array(n + 1).fill(0n);
    const pow10 = new Array(n + 1).fill(1n);

    for (let i = 1; i <= n; i++) {
        pow10[i] = (pow10[i - 1] * 10n) % MOD;
    }

    for (let i = 0; i < n; i++) {
        const d = s.charCodeAt(i) - 48;

        prefixSum[i + 1] = prefixSum[i] + d;
        prefixCnt[i + 1] = prefixCnt[i];
        prefixNum[i + 1] = prefixNum[i];

        if (d !== 0) {
            prefixCnt[i + 1]++;
            prefixNum[i + 1] = (prefixNum[i] * 10n + BigInt(d)) % MOD;
        }
    }

    const ans = [];

    for (const [l, r] of queries) {
        const cnt = prefixCnt[r + 1] - prefixCnt[l];
        const digitSum = prefixSum[r + 1] - prefixSum[l];

        let x = (prefixNum[r + 1] -
                (prefixNum[l] * pow10[cnt]) % MOD +
                MOD) % MOD;

        ans.push(Number((x * BigInt(digitSum)) % MOD));
    }

    return ans;
};
