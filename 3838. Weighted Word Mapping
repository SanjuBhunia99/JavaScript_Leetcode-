var mapWordWeights = function(words, weights) {
    let ans = "";

    for (const word of words) {
        let sum = 0;
        for (const ch of word) {
            sum += weights[ch.charCodeAt(0) - 97]; 
        }
        const idx = sum % 26;
        ans += String.fromCharCode(122 - idx); 
    }

    return ans;
};
