
var subsequencePairCount = function(nums) {
    const MOD = 1000000007;
    const maxNum = Math.max(...nums);

    const gcd = (a, b) => {
        while (b !== 0) {
            const t = a % b;
            a = b;
            b = t;
        }
        return a;
    };

    let dp = Array.from({ length: maxNum + 1 }, () =>
        new Array(maxNum + 1).fill(0)
    );
    dp[0][0] = 1;

    for (const num of nums) {
        const next = Array.from({ length: maxNum + 1 }, () =>
            new Array(maxNum + 1).fill(0)
        );

        for (let g1 = 0; g1 <= maxNum; g1++) {
            for (let g2 = 0; g2 <= maxNum; g2++) {
                const ways = dp[g1][g2];
                if (ways === 0) continue;

                
                next[g1][g2] = (next[g1][g2] + ways) % MOD;

                
                const ng1 = gcd(g1, num);
                next[ng1][g2] = (next[ng1][g2] + ways) % MOD;

                
                const ng2 = gcd(g2, num);
                next[g1][ng2] = (next[g1][ng2] + ways) % MOD;
            }
        }

        dp = next;
    }

    let ans = 0;
    for (let g = 1; g <= maxNum; g++) {
        ans = (ans + dp[g][g]) % MOD;
    }

    return ans;
};
