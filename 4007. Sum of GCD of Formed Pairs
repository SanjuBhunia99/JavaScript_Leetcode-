var gcdSum = function(nums) {
    const gcd = (a, b) => {
        while (b !== 0) {
            let temp = a % b;
            a = b;
            b = temp;
        }
        return a;
    };

    const prefix = [];
    let mx = 0;

    for (const num of nums) {
        mx = Math.max(mx, num);
        prefix.push(gcd(num, mx));
    }

    prefix.sort((a, b) => a - b);

    let ans = 0;
    let left = 0;
    let right = prefix.length - 1;

    while (left < right) {
        ans += gcd(prefix[left], prefix[right]);
        left++;
        right--;
    }

    return ans;
};
