var numberOfSpecialChars = function(word) {
    let count = 0;

    for (let i = 0; i < 26; i++) {
        const lower = String.fromCharCode(97 + i);
        const upper = String.fromCharCode(65 + i);

        if (word.includes(lower) && word.includes(upper)) {
            count++;
        }
    }
    return count;
};
